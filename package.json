{
  "name": "@xyb-community/gastric-workbench",
  "version": "0.1.4",
  "description": "小胃宝 Stompal：本机优先的胃癌标志物档案、进食与营养（切除/倾倒/补充剂）、腹膜与腹腔治疗留痕、复诊准备工作台",
  "private": true,
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./version": "./lib/version.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh",
    "lib",
    "public",
    "schema",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "demo"
  ],
  "scripts": {
    "start": "node scripts/dev-server.mjs",
    "build:version": "node scripts/build-version.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:wording": "node scripts/check-wording.mjs",
    "check:package": "node scripts/check-workbench-package.mjs .",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.mjs",
    "check": "node scripts/build-version.mjs --check && node scripts/check-syntax.mjs && node scripts/check-schema.mjs && node scripts/check-wording.mjs && node scripts/check-trial-snapshot.mjs . && node scripts/check-trial-matching.mjs --self-test && node scripts/check-trial-matching.mjs . && node scripts/check-patient-create.mjs && node --disable-warning=ExperimentalWarning --test test/*.test.mjs && node scripts/check-version.mjs && node scripts/check-workbench-package.mjs . && node scripts/check-primer-links.mjs && node scripts/check-agent-pane-contract.mjs .",
    "pack:check": "npm pack --dry-run",
    "probe:primer": "node scripts/probe-disease-primer.mjs",
    "check:install": "node scripts/check-install.mjs",
    "build:demo-data": "node scripts/build-public-demo-data.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xyb-openharness-dsh-plugins/gastric-workbench"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "engines": {
    "node": ">=22.5"
  },
  "license": "MIT"
}
